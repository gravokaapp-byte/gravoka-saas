rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Multi-tenant Security Rules
    match /empresas/{empresaId} {
      allow read, write: if request.auth != null;
    }
    match /usuarios/{usuarioId} {
      allow read, write: if request.auth != null;
    }
    match /clientes/{clienteId} {
      allow read, write: if request.auth != null;
    }
    match /guias/{guiaId} {
      allow read, write: if request.auth != null;
    }
  }
}
